#!/bin/sh
# Dock: always visible at the bottom (Dash to Dock, mOS style) with Chromium, Files, Software,
# Settings, Terminal and Install mOS.
set -e

echo "I: mOS dock"

pick() {
	for name in "$@"; do
		if [ -f "/usr/share/applications/${name}" ]; then
			printf "'%s'" "${name}"
			return 0
		fi
	done
	return 1
}

apps=""
add() {
	if entry="$(pick "$@")"; then
		if [ -z "${apps}" ]; then apps="${entry}"; else apps="${apps}, ${entry}"; fi
	else
		echo "W: none of $* found; skipping in the dock"
	fi
}

add chromium.desktop
add org.gnome.Nautilus.desktop
add org.gnome.Software.desktop
add org.gnome.Settings.desktop
add org.gnome.Console.desktop org.gnome.Terminal.desktop
installer="$(grep -lE '^Exec=.*(calamares|install-debian)' /usr/share/applications/*.desktop 2>/dev/null | head -n 1 || true)"
if [ -n "${installer}" ]; then
	add "$(basename "${installer}")"
fi

DOCK_UUID=dash-to-dock@micxgx.gmail.com
if [ ! -d "/usr/share/gnome-shell/extensions/${DOCK_UUID}" ]; then
	echo "E: Dash to Dock is missing (gnome-shell-extension-dashtodock)" >&2
	exit 1
fi

# The dock's settings schema must be in the system schema folder for our defaults to apply.
if [ ! -f /usr/share/glib-2.0/schemas/org.gnome.shell.extensions.dash-to-dock.gschema.xml ]; then
	find "/usr/share/gnome-shell/extensions/${DOCK_UUID}" -name 'org.gnome.shell.extensions.dash-to-dock.gschema.xml' \
		-exec cp {} /usr/share/glib-2.0/schemas/ \;
fi

cat > /usr/share/glib-2.0/schemas/91_mos-dock.gschema.override <<EOF
[org.gnome.shell]
favorite-apps=[${apps}]
enabled-extensions=['${DOCK_UUID}']

[org.gnome.shell.extensions.dash-to-dock]
dock-position='BOTTOM'
dock-fixed=true
autohide=false
intellihide=false
extend-height=false
dash-max-icon-size=48
icon-size-fixed=true
show-trash=false
show-mounts=false
show-apps-at-top=false
show-show-apps-button=true
running-indicator-style='DOTS'
apply-custom-theme=false
custom-theme-shrink=true
transparency-mode='FIXED'
custom-background-color=true
background-color='rgb(255,255,255)'
background-opacity=0.28
disable-overview-on-startup=true
hot-keys=false
EOF
cat /usr/share/glib-2.0/schemas/91_mos-dock.gschema.override
glib-compile-schemas /usr/share/glib-2.0/schemas
