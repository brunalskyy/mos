#!/bin/sh
# mOS branding inside the live system: name, version, logo and wallpaper.
set -e

echo "I: mOS branding"

# System name shown in Settings > About, hostnamectl and the login screen.
# The version comes from /usr/share/mos/version (updated with every mOS update).
# ID stays "debian" and VERSION_CODENAME stays "trixie" so Debian tools keep working.
NAME_FULL="$(python3 -c 'import json;print(json.load(open("/usr/share/mos/version"))["name"])')"
VER="$(python3 -c 'import json;print(json.load(open("/usr/share/mos/version"))["version"])')"
cat > /usr/lib/os-release <<EOF
PRETTY_NAME="${NAME_FULL}"
NAME="mOS"
VERSION_ID="1.0"
VERSION="1.0 Amber (${VER})"
VERSION_CODENAME=trixie
ID=debian
HOME_URL="https://brunalskyy.github.io/mos/"
SUPPORT_URL="https://github.com/brunalskyy/mos/issues"
BUG_REPORT_URL="https://github.com/brunalskyy/mos/issues"
LOGO=mos-logo
EOF
ln -sf ../usr/lib/os-release /etc/os-release

# Text console and login banners
printf '%s \\n \\l\n\n' "${NAME_FULL}" > /etc/issue
printf '%s\n' "${NAME_FULL}" > /etc/issue.net

# Logo icon and wallpaper defaults
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
	gtk-update-icon-cache -f -q /usr/share/icons/hicolor || true
	for t in mOS mOS-Squircle mOS-Rounded; do gtk-update-icon-cache -f -q "/usr/share/icons/${t}" || true; done
fi
glib-compile-schemas /usr/share/glib-2.0/schemas
