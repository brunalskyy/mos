#!/bin/sh
# Fail the build if any visible Debian branding is left where mOS should be.
set -e

echo "I: checking mOS branding"
fail=0

# Boot animation inside the initramfs (what you see while it loads)
for initrd in /boot/initrd.img-*; do
	work="$(mktemp -d)"
	unmkinitramfs "${initrd}" "${work}"
	conf="$(find "${work}" -path '*etc/plymouth/plymouthd.conf' | head -n 1)"
	default="$(find "${work}" -name 'default.plymouth' | head -n 1)"
	echo "I: ${initrd}: plymouthd.conf: $(cat "${conf}" 2>/dev/null | tr '\n' ' ')"
	if [ -n "${default}" ]; then
		echo "I: ${initrd}: default.plymouth -> $(readlink "${default}" || echo file)"
	fi
	if ! find "${work}" -path '*plymouth/themes/mos/mos.plymouth' | grep -q .; then
		echo "E: the mOS boot animation is not in ${initrd}" >&2
		fail=1
	fi
	if [ -z "${conf}" ] || ! grep -q '^Theme=mos' "${conf}"; then
		echo "E: ${initrd} does not select the mOS boot animation" >&2
		fail=1
	fi
	theme="$(find "${work}" -type d -path '*plymouth/themes/mos' | head -n 1)"
	if [ -n "${theme}" ]; then
		echo "I: ${initrd}: boot animation files: $(ls "${theme}" | tr '\n' ' ')"
		echo "I: ${initrd}: watermark $(md5sum < "${theme}/watermark.png" 2>/dev/null) vs mOS $(md5sum < /usr/share/plymouth/themes/mos/watermark.png)"
		if ! cmp -s "${theme}/watermark.png" /usr/share/plymouth/themes/mos/watermark.png; then
			echo "E: the boot logo in ${initrd} is not the mOS logo" >&2
			fail=1
		fi
		for bad in bgrt-fallback.png header-image.png; do
			if [ -e "${theme}/${bad}" ]; then
				echo "E: ${initrd} still has ${bad} (the Debian logo) in the boot animation" >&2
				fail=1
			fi
		done
	fi
	echo "I: ${initrd}: plymouth themes: $(ls "$(dirname "${theme:-/nonexistent}")" 2>/dev/null | tr '\n' ' ')"
	rm -rf "${work}"
done

# mOS 0.4: lock screen clock, Settings app, icon shapes
if ! grep -q 'MosClock {' /usr/share/plasma/shells/org.kde.plasma.desktop/contents/lockscreen/LockScreenUi.qml; then
	echo "E: the mOS lock screen clock is not in place" >&2
	fail=1
fi
if ! python3 -c "import PySide6.QtQuick, PySide6.QtQml" 2>/dev/null; then
	echo "E: mOS Settings cannot start (PySide6 is missing)" >&2
	fail=1
fi
if ! python3 -m py_compile /usr/lib/mos-settings/mos_settings.py; then
	echo "E: mOS Settings has a Python error" >&2
	fail=1
fi
for t in mOS mOS-Squircle mOS-Rounded; do
	if [ ! -f "/usr/share/icons/${t}/48x48/apps/system-file-manager.png" ]; then
		echo "E: the ${t} icon theme is missing" >&2
		fail=1
	fi
done
if ! fc-list | grep -qi 'Inter'; then
	echo "W: the Inter font is not installed" >&2
fi

# 0.4.1: no KDE splash, mOS login screen
if [ -d /usr/share/plasma/look-and-feel/org.mos.desktop/contents/splash ]; then
	echo "E: the KDE splash is still in the mOS global theme" >&2
	fail=1
fi
if [ -f /usr/share/sddm/themes/breeze/Main.qml ] && ! grep -q 'MosClock {' /usr/share/sddm/themes/mos/Main.qml 2>/dev/null; then
	echo "E: the mOS login screen is not in place" >&2
	fail=1
fi

# 0.5: full Settings, updates, Material colours
for f in /usr/lib/mos-settings/mos_welcome.py /usr/bin/mos-themed-icons /usr/bin/mos-auto-theme /usr/lib/mos-settings/mos_settings.py /usr/lib/mos-settings/mos_account.py /usr/lib/mos-settings/mos_update.py /usr/lib/mos-settings/mos-update-helper /usr/bin/mos-update-check; do
	if ! python3 -m py_compile "${f}" 2>/dev/null; then
		echo "E: ${f} has a Python error" >&2
		fail=1
	fi
done
find /usr/lib/mos-settings -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true
for f in /usr/share/color-schemes/mOSLight.colors /usr/share/color-schemes/mOSDark.colors /usr/share/mos/version /usr/share/polkit-1/actions/org.mos.update.policy; do
	if [ ! -f "${f}" ]; then
		echo "E: ${f} is missing" >&2
		fail=1
	fi
done
if [ "$(ls /usr/lib/mos-settings/pages/*.qml | wc -l)" -lt 20 ]; then
	echo "E: mOS Settings pages are missing" >&2
	fail=1
fi
if ! dpkg -s mos-desktop >/dev/null 2>&1; then
	echo "W: the mos-desktop package is not installed (updates will still work)" >&2
fi

# 0.6: Pixel widgets, Windows 10 window buttons, no KDE Wallet
for f in /usr/bin/mos-themed-icons /usr/bin/mos-auto-theme /usr/bin/mos-welcome /usr/lib/mos-settings/welcome/Welcome.qml /usr/share/mos/glyphs/folder.svg /etc/xdg/autostart/mos-welcome.desktop /usr/share/plasma/plasmoids/org.mos.clock/metadata.json /usr/share/plasma/plasmoids/org.mos.battery/metadata.json /usr/share/aurorae/themes/mOS-Dark/decoration.svg; do
	if [ ! -f "${f}" ]; then
		echo "E: ${f} is missing" >&2
		fail=1
	fi
done
if ! grep -q '^ButtonsOnRight=IAX' /etc/xdg/kwinrc; then
	echo "E: the Windows-style window buttons are not set" >&2
	fail=1
fi
if ! grep -q '^Enabled=false' /etc/xdg/kwalletrc 2>/dev/null; then
	echo "E: KDE Wallet is still switched on" >&2
	fail=1
fi

# 0.6.1: Control Centre, clock with notifications, At a glance, mOS Store, app style, backup
for f in /usr/bin/mos-cc /usr/bin/mos-store /usr/bin/mos-kvantum /usr/bin/mos-migrate /usr/lib/mos-store/mos_store.py; do
	if ! python3 -m py_compile "${f}" 2>/dev/null && ! head -1 "${f}" | grep -q '^#!/bin/sh'; then
		echo "E: ${f} has a Python error" >&2
		fail=1
	fi
done
find /usr/lib/mos-store /usr/bin -maxdepth 1 -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true
for f in /usr/share/plasma/plasmoids/org.mos.controlcentre/contents/ui/main.qml /usr/share/plasma/plasmoids/org.mos.taskclock/contents/ui/main.qml /usr/share/plasma/plasmoids/org.mos.glance/contents/ui/main.qml /usr/lib/mos-store/Main.qml /usr/lib/mos-store/pages/AppPage.qml /usr/share/applications/mos-store.desktop /usr/share/icons/mOS/128x128/apps/mos-store.png /usr/lib/mos-settings/pages/fonts.qml /usr/lib/mos-settings/pages/printers.qml /usr/lib/mos-settings/pages/shortcuts.qml /usr/lib/systemd/user/mos-backup.timer /etc/xdg/autostart/mos-migrate.desktop; do
	if [ ! -f "${f}" ]; then
		echo "E: ${f} is missing" >&2
		fail=1
	fi
done
if ! grep -q 'org.mos.controlcentre' "/usr/share/plasma/look-and-feel/org.mos.desktop/contents/layouts/org.kde.plasma.desktop-layout.js" 2>/dev/null; then
	echo "E: the taskbar layout has no Control Centre" >&2
	fail=1
fi
if dpkg -s plasma-discover >/dev/null 2>&1; then
	echo "W: KDE Discover is still installed (the mOS Store replaces it; it's hidden from menus)" >&2
fi
if ! python3 -c "import gi; gi.require_version('Flatpak', '1.0'); from gi.repository import Flatpak" 2>/dev/null; then
	echo "W: libflatpak for Python is missing; the mOS Store installs without speed and time left" >&2
fi
if [ ! -f /usr/share/Kvantum/mOS/mOS.kvconfig ]; then
	echo "W: the mOS app style (Kvantum) wasn't made; apps keep the KDE look" >&2
fi
ls /var/lib/flatpak/appstream/flathub/*/active/appstream.xml* 2>/dev/null || echo "W: no Flathub app list yet (the mOS Store gets it on first run)"

# MacBook Air (2017) Wi-Fi: the Broadcom wl driver must be in the image
if ! find /lib/modules -name 'wl.ko*' | grep -q .; then
	echo "E: the Broadcom wl Wi-Fi driver is missing (MacBook Air Wi-Fi won't work)" >&2
	fail=1
fi
# 0.6.2: mOS password pop-up (KDE's stays as the backup)
if ! python3 -m py_compile /usr/lib/mos-polkit/mos_polkit_agent.py 2>/dev/null; then
	echo "E: the mOS password pop-up has a Python error" >&2
	fail=1
fi
find /usr/lib/mos-polkit -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true
if ! python3 -c "import gi; gi.require_version('Polkit', '1.0'); gi.require_version('PolkitAgent', '1.0'); from gi.repository import Polkit, PolkitAgent" 2>/dev/null; then
	echo "E: polkit for Python is missing (the mOS password pop-up can't start)" >&2
	fail=1
fi
for f in /usr/lib/mos-polkit/Dialog.qml /usr/lib/systemd/user/mos-polkit-agent.service /usr/lib/systemd/user/plasma-polkit-agent.service.d/mos.conf; do
	[ -f "${f}" ] || { echo "E: ${f} is missing" >&2; fail=1; }
done
# 0.6.2: no second Settings (KDE's System Settings is hidden everywhere)
if [ -f /usr/share/applications/systemsettings.desktop ] && ! grep -q '^Hidden=true' /usr/local/share/applications/systemsettings.desktop 2>/dev/null; then
	echo "E: KDE System Settings still shows next to mOS Settings" >&2
	fail=1
fi
# 0.6.2: Files laid out like Windows 11 File Explorer
if ! grep -q 'name="commandBar"' /usr/share/kxmlgui5/dolphin/dolphinui.rc 2>/dev/null; then
	echo "E: the Explorer-style Files layout is missing" >&2
	fail=1
fi

# System name
if ! grep -q '^NAME="mOS"' /usr/lib/os-release; then
	echo "E: os-release does not say mOS" >&2
	fail=1
fi

# Installer
if ! grep -rqs '^\s*branding:\s*mos' /etc/calamares/settings.conf /usr/share/calamares/settings.conf; then
	echo "E: Calamares is not using the mOS branding" >&2
	fail=1
fi
if grep -lE '^Exec=.*(calamares|install-debian)' /usr/share/applications/*.desktop 2>/dev/null | xargs -r grep -qE '^Name=.*Debian'; then
	echo "E: the installer launcher still says Debian" >&2
	fail=1
fi
if grep -lsE '^Exec=.*(calamares|install-debian)' /etc/xdg/autostart/*.desktop | grep -q .; then
	echo "E: the installer still opens by itself" >&2
	fail=1
fi

# Desktop (KDE Plasma): mOS global theme with the top bar + dock layout, and desktop icons
LAYOUT=/usr/share/plasma/look-and-feel/org.mos.desktop/contents/layouts/org.kde.plasma.desktop-layout.js
if ! grep -qE 'org.kde.plasma.(icontasks|taskmanager)' "${LAYOUT}" 2>/dev/null; then
	echo "E: the mOS desktop layout (taskbar) is missing" >&2
	fail=1
fi
if ! grep -q '^LookAndFeelPackage=org.mos.desktop' /etc/xdg/kdeglobals; then
	echo "E: Plasma is not set to the mOS global theme" >&2
	fail=1
fi
if [ ! -f /usr/share/wallpapers/mOS/contents/images/2880x1800.png ]; then
	echo "E: the mOS wallpaper is missing" >&2
	fail=1
fi
if ! grep -q 'org.mos.clock' "${LAYOUT}" 2>/dev/null; then
	echo "E: the mOS desktop layout (Pixel clock) is missing" >&2
	fail=1
fi
if [ ! -f /usr/share/aurorae/themes/mOS/decoration.svg ] || ! grep -q '__aurorae__svg__mOS' /etc/xdg/kwinrc; then
	echo "E: the mOS window style is missing" >&2
	fail=1
fi
if ! find /usr/lib /usr/share/kwin -iname '*aurorae*' 2>/dev/null | grep -q .; then
	echo "W: could not find the Aurorae engine files; the mOS window style may not load"
fi
find /usr/lib -iname '*aurorae*' 2>/dev/null | head -n 5
if [ ! -x /usr/bin/plasmashell ] || [ ! -x /usr/bin/sddm ]; then
	echo "E: KDE Plasma or SDDM is not installed" >&2
	fail=1
fi

if [ "${fail}" -ne 0 ]; then
	echo "E: mOS branding check failed" >&2
	exit 1
fi
echo "I: mOS branding check passed"
