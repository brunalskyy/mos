#!/bin/sh
# mOS desktop: our own right-click menu on empty desktop space (Add widgets, Edit widgets,
# New folder, Paste, Refresh, Open in Terminal, Change wallpaper, Display settings, Settings),
# and KDE's "Add Widgets" sidebar opens the mOS widget gallery instead (only mOS widgets).
# Right-clicking files still gives the full file menu. Panels keep KDE's widget list.
#
# KDE's files are kept with dpkg-divert (.debian), and each run patches a fresh copy,
# so a Plasma update can't leave a half-patched file behind.
set -e

echo "I: mOS desktop menu and widget gallery"

FV=/usr/share/plasma/plasmoids/org.kde.desktopcontainment/contents/ui/FolderView.qml
WE=/usr/share/plasma/shells/org.kde.plasma.desktop/contents/explorer/WidgetExplorer.qml

for f in "${FV}" "${WE}"; do
	if [ ! -f "${f}" ] && [ ! -f "${f}.debian" ]; then
		echo "W: ${f} is missing; skipping the mOS desktop menu" >&2
		exit 0
	fi
	dpkg-divert --local --rename --divert "${f}.debian" --add "${f}"
	cp "${f}.debian" "${f}"
done
cp /usr/share/mos/desktop/MosDesktopMenu.qml "$(dirname "${FV}")/"

set +e
python3 - "${FV}" "${WE}" <<'PY'
import re, sys
fv, we = sys.argv[1], sys.argv[2]

def patch(path, steps):
    s = open(path).read()
    for pattern, repl in steps:
        s2, n = re.subn(pattern, repl, s, count=1, flags=re.S)
        if n == 0:
            i = s.find("openContextMenu")
            sys.stderr.write("E: desktop menu: no match in %s for %r\n--- near:\n%s\n" % (path, pattern[:60], s[max(0, i - 400):i + 200]))
            sys.exit(1)
        s = s2
    open(path, "w").write(s)

# Right-click on empty desktop space -> the mOS menu (the first openContextMenu(main, ...) is the
# empty-space one; right-clicking a file keeps the full file menu)
patch(fv, [
    (r"dir\.openContextMenu\(main,\s*mouse\.modifiers\);",
     "if (root.isContainment) { var mosAt = mapToItem(main, mouse.x, mouse.y); "
     "mosDesktopMenu.popup(main, mosAt.x, mosAt.y); } else { dir.openContextMenu(main, mouse.modifiers); }"),
    (r"(FocusScope\s*\{\s*id:\s*main\s*\n)",
     r"\1\n    MosDesktopMenu { id: mosDesktopMenu; folder: dir }\n"),
])

# KDE's "Add Widgets" for the desktop -> the mOS widget gallery
patch(we, [
    (r"(import org\.kde\.plasma\.private\.shell[^\n]*\n)",
     r"\1import org.kde.plasma.plasma5support as P5Support\n"),
    (r"root\.widgetExplorer\.containment\s*=\s*main\.containment\s*\n\s*\}",
     """root.widgetExplorer.containment = main.containment
        // mOS: on the desktop, open the mOS widget gallery instead of KDE's list
        if (main.containment && main.containment.containmentType !== 1 && main.containment.containmentType !== 128) {
            mosGallery.connectSource("mos-widgets")
            Qt.callLater(main.closed)
        }
    }

    P5Support.DataSource {
        id: mosGallery
        engine: "executable"
        onNewData: function (source) { disconnectSource(source) }
    }"""),
])
print("I: mOS desktop menu in; Add Widgets opens the mOS gallery")
PY
rc=$?
set -e
if [ "${rc}" -ne 0 ]; then
	# Couldn't match KDE's file: keep KDE's own menu and sidebar rather than break anything
	echo "W: mOS desktop menu not applied; KDE's menu stays" >&2
	cp "${FV}.debian" "${FV}"
	cp "${WE}.debian" "${WE}"
	exit 0
fi

grep -q 'mosDesktopMenu.popup' "${FV}" || echo "W: mOS desktop menu missing" >&2
exit 0
