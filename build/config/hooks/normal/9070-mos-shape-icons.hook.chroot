#!/bin/sh
# mOS: every app icon in the mOS shape.
# Apps without an mOS icon get their picture on a tile in each shape
# (circle, squircle, rounded square). Apps installed later are done by a
# small user service that watches for new apps.
set -e

echo "I: mOS icon shapes for every app"
/usr/bin/mos-shape-icons
systemctl --global enable mos-shape-icons.path
systemctl --global enable mos-update-check.timer
systemctl --global enable mos-auto-theme.timer
systemctl --global enable mos-backup.timer
systemctl enable mos-cleanup.service 2>/dev/null || true
systemctl enable mos-glass-check.service 2>/dev/null || true
systemctl enable mos-avatar-sync.service 2>/dev/null || true
systemctl enable mos-apple.service 2>/dev/null || true
/usr/lib/mos/mos-glass-check || true

# Hide the old KDE System Settings from the Start menu: mOS Settings does it all
for f in /usr/share/applications/systemsettings.desktop /usr/share/applications/kdesystemsettings.desktop; do
	if [ -f "${f}" ] && ! grep -q "^NoDisplay=true" "${f}"; then
		sed -i "/^\[Desktop Entry\]/a NoDisplay=true" "${f}"
	fi
done
