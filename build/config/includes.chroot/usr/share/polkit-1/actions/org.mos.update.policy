<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>mOS</vendor>
  <vendor_url>https://brunalskyy.github.io/mos/</vendor_url>
  <icon_name>mos-logo</icon_name>
  <action id="org.mos.update">
    <description>Install mOS updates</description>
    <message>Type your password to install updates</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mos-settings/mos-update-helper</annotate>
  </action>
</policyconfig>
