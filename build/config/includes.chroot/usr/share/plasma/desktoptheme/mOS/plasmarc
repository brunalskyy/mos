[Wallpaper]
defaultWallpaperTheme=Next
defaultFileSuffix=.png
defaultWidth=1920
defaultHeight=1080

[ContrastEffect]
# Liquid glass (0.7.3): almost clear, like the iOS dock. Barely any greying or
# darkening, so the wallpaper shows through and the bending at the edges is visible.
enabled=true
contrast=0.9
intensity=1.0
saturation=1.25

[AdaptiveTransparency]
# Off: the taskbar stays see-through even with a maximised window
enabled=false
