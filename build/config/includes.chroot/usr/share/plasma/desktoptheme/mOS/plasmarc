[Wallpaper]
defaultWallpaperTheme=Next
defaultFileSuffix=.png
defaultWidth=1920
defaultHeight=1080

[ContrastEffect]
# Liquid glass (0.7.2): clear glass, so the bending at the edges actually shows.
# A light touch of contrast keeps text readable without greying out what's behind.
enabled=true
contrast=0.6
intensity=1.1
saturation=1.5

[AdaptiveTransparency]
# Off: the taskbar stays see-through even with a maximised window
enabled=false
