#!/usr/bin/python3
"""mOS Apple Control Panel helper: runs as root (through pkexec, or at start-up).

  mos-apple-helper fan auto|quiet|cool       fan mode
  mos-apple-helper fan manual <rpm>          fixed fan speed (never below the Mac's own minimum)
  mos-apple-helper fnmode 1|2                top row: 1 = brightness/volume keys, 2 = F1-F12
  mos-apple-helper swap 0|1                  1 = swap Cmd and Option (Windows layout)
  mos-apple-helper boot                      at start-up: re-apply the saved settings and show
                                             the app only on Macs

Settings are kept in /etc/mos/apple.json. It only ever writes to the Mac's own SMC fan
controls and the Apple keyboard driver's settings.
SPDX-FileCopyrightText: 2026 Bruno Woznicki
SPDX-License-Identifier: GPL-3.0-or-later
"""
import glob
import json
import os
import sys

CONF = "/etc/mos/apple.json"
SMC = "/sys/devices/platform/applesmc.768"
HID = "/sys/module/hid_apple/parameters"
MODPROBE = "/etc/modprobe.d/mos-apple.conf"
LAUNCHER_SRC = "/usr/share/mos/apple/mos-apple.desktop"
LAUNCHER = "/usr/local/share/applications/mos-apple.desktop"


def is_mac():
    try:
        return "apple" in open("/sys/class/dmi/id/sys_vendor").read().lower()
    except OSError:
        return False


def load():
    try:
        return json.load(open(CONF))
    except (OSError, ValueError):
        return {}


def save(conf):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF + ".new", "w") as f:
        json.dump(conf, f, indent=2)
    os.replace(CONF + ".new", CONF)


def put(path, value):
    with open(path, "w") as f:
        f.write(str(value))


def fans():
    out = []
    for p in sorted(glob.glob(os.path.join(SMC, "fan[0-9]_input"))):
        n = os.path.basename(p).split("_")[0]
        out.append(n)
    return out


def read_int(path, default=0):
    try:
        return int(open(path).read().strip())
    except (OSError, ValueError):
        return default


def apply_fan(conf):
    mode = conf.get("fan", "auto")
    for n in fans():
        base = os.path.join(SMC, n)
        # Remember the Mac's own minimum the first time, so "Quiet" can go back to it
        hw_min = conf.setdefault("hwMin", {}).setdefault(n, read_int(base + "_min", 1200))
        hw_max = read_int(base + "_max", 6500)
        if mode == "manual":
            rpm = max(hw_min, min(hw_max, int(conf.get("rpm", hw_min))))
            put(base + "_manual", 1)
            put(base + "_output", rpm)
        else:
            put(base + "_manual", 0)
            floor = hw_min if mode in ("auto", "quiet") else int(hw_min + (hw_max - hw_min) * 0.45)
            put(base + "_min", floor)


def apply_keyboard(conf):
    if os.path.isdir(HID):
        if "fnmode" in conf:
            put(os.path.join(HID, "fnmode"), conf["fnmode"])
        if "swap" in conf:
            put(os.path.join(HID, "swap_opt_cmd"), conf["swap"])
    opts = []
    if "fnmode" in conf:
        opts.append("fnmode=%d" % conf["fnmode"])
    if "swap" in conf:
        opts.append("swap_opt_cmd=%d" % conf["swap"])
    if opts:
        with open(MODPROBE, "w") as f:
            f.write("# mOS Apple Control Panel: keyboard settings\noptions hid_apple %s\n" % " ".join(opts))


def main(argv):
    if not argv:
        sys.exit(__doc__)
    cmd = argv[0]
    if cmd == "boot":
        if is_mac():
            os.makedirs(os.path.dirname(LAUNCHER), exist_ok=True)
            if os.path.exists(LAUNCHER_SRC):
                with open(LAUNCHER_SRC) as a, open(LAUNCHER, "w") as b:
                    b.write(a.read())
            conf = load()
            try:
                if os.path.isdir(SMC):
                    apply_fan(conf)
                apply_keyboard(conf)
                save(conf)
            except OSError as e:
                print("could not apply Apple settings:", e)
        elif os.path.exists(LAUNCHER):
            os.remove(LAUNCHER)
        return
    if not is_mac():
        sys.exit("This isn't a Mac")
    conf = load()
    if cmd == "fan" and len(argv) >= 2 and argv[1] in ("auto", "quiet", "cool", "manual"):
        conf["fan"] = argv[1]
        if argv[1] == "manual":
            conf["rpm"] = int(argv[2]) if len(argv) > 2 and argv[2].isdigit() else 2000
        apply_fan(conf)
    elif cmd == "fnmode" and len(argv) == 2 and argv[1] in ("1", "2"):
        conf["fnmode"] = int(argv[1])
        apply_keyboard(conf)
    elif cmd == "swap" and len(argv) == 2 and argv[1] in ("0", "1"):
        conf["swap"] = int(argv[1])
        apply_keyboard(conf)
    else:
        sys.exit(__doc__)
    save(conf)
    print("ok")


if __name__ == "__main__":
    main(sys.argv[1:])
