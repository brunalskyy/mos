#!/usr/bin/python3
"""mOS: show your profile picture on the sign-in screen when the computer starts.

The sign-in screen (SDDM) runs before you sign in, so it can't read your home
folder. At start-up this copies each person's picture (~/.face.icon or ~/.face)
to /var/lib/AccountsService/icons/<name>, where the sign-in screen looks.
Runs as root, so it only copies real pictures (PNG, JPEG, WebP, under 20 MB)
that live in that person's own home folder or come with mOS (/usr/share).
SPDX-FileCopyrightText: 2026 Bruno Woznicki
SPDX-License-Identifier: GPL-3.0-or-later
"""
import os
import pwd
import stat

ICONS = "/var/lib/AccountsService/icons"
USERS = "/var/lib/AccountsService/users"
MAGIC = (b"\x89PNG\r\n\x1a\n", b"\xff\xd8\xff", b"RIFF")


def picture_for(user):
    home = os.path.realpath(user.pw_dir)
    for name in (".face.icon", ".face"):
        p = os.path.join(user.pw_dir, name)
        if not os.path.lexists(p):
            continue
        real = os.path.realpath(p)
        allowed = real.startswith(home + os.sep) or real.startswith("/usr/share/")
        if not allowed:
            continue
        try:
            fd = os.open(real, os.O_RDONLY | os.O_NOFOLLOW)
        except OSError:
            continue
        with os.fdopen(fd, "rb") as f:
            st = os.fstat(f.fileno())
            if not stat.S_ISREG(st.st_mode) or st.st_size > 20 * 1024 * 1024:
                continue
            if real.startswith(home + os.sep) and st.st_uid not in (user.pw_uid, 0):
                continue
            data = f.read()
        if data.startswith(MAGIC):
            return data
    return None


def set_icon(user, path):
    cfg = os.path.join(USERS, user.pw_name)
    lines = []
    try:
        lines = open(cfg).read().splitlines()
    except OSError:
        pass
    if not any(l.strip() == "[User]" for l in lines):
        lines = ["[User]"] + lines
    lines = [l for l in lines if not l.startswith("Icon=")]
    i = next(n for n, l in enumerate(lines) if l.strip() == "[User]")
    lines.insert(i + 1, "Icon=" + path)
    os.makedirs(USERS, mode=0o700, exist_ok=True)
    with open(cfg, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.chmod(cfg, 0o600)


def main():
    os.makedirs(ICONS, mode=0o755, exist_ok=True)
    for user in pwd.getpwall():
        if user.pw_uid < 1000 or user.pw_uid >= 60000 or not os.path.isdir(user.pw_dir):
            continue
        data = picture_for(user)
        if not data:
            continue
        dest = os.path.join(ICONS, user.pw_name)
        tmp = dest + ".new"
        with open(tmp, "wb") as f:
            f.write(data)
        os.chmod(tmp, 0o644)
        os.replace(tmp, dest)
        set_icon(user, dest)
        print("picture for " + user.pw_name)


if __name__ == "__main__":
    main()
