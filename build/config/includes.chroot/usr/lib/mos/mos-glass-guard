#!/usr/bin/env python3
"""mOS Liquid Glass guard (runs at sign-in).
If Liquid Glass is switched on but KWin couldn't load it, turn KDE's normal blur on
for this session, so the taskbar and pop-ups never lose their glass.
SPDX-FileCopyrightText: 2026 Bruno Woznicki
SPDX-License-Identifier: GPL-3.0-or-later
"""
import subprocess
import time


def busctl(*args):
    try:
        return subprocess.run(["busctl", "--user", *args], capture_output=True, text=True, timeout=10).stdout
    except Exception:
        return ""


def kwinrc(key, default):
    """Read [Plugins] key from your kwinrc, then the mOS default in /etc/xdg."""
    import os
    for path in (os.path.expanduser("~/.config/kwinrc"), "/etc/xdg/kwinrc"):
        group = ""
        try:
            for line in open(path, encoding="utf-8", errors="ignore"):
                line = line.strip()
                if line.startswith("["):
                    group = line
                elif group == "[Plugins]" and line.split("=", 1)[0].strip() == key and "=" in line:
                    return line.split("=", 1)[1].strip().lower() == "true"
        except OSError:
            pass
    return default == "true"


def main():
    if not kwinrc("mosglassEnabled", "true"):
        return
    for _ in range(20):
        time.sleep(3)
        out = busctl("call", "org.kde.KWin", "/Effects", "org.kde.kwin.Effects", "isEffectLoaded", "s", "mosglass")
        if out.startswith("b true"):
            return
        if out.startswith("b false") and _ >= 2:
            break
    busctl("call", "org.kde.KWin", "/Effects", "org.kde.kwin.Effects", "loadEffect", "s", "blur")


if __name__ == "__main__":
    main()
