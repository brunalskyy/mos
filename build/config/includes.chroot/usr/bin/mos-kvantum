#!/usr/bin/env python3
"""mos-kvantum: round Material buttons, fields and menus inside apps (Dolphin, Konsole, Kate…).

Makes an mOS Kvantum theme in your accent colour and light/dark mode, from one of the
rounded themes that come with Kvantum, and switches apps to it.

  mos-kvantum            make your theme (accent + light/dark now) and use it
  mos-kvantum --system   make the default mOS themes for everyone (used when building mOS)
  mos-kvantum --off      go back to the plain KDE look (Breeze)

Apps you already have open pick it up next time they start.

SPDX-FileCopyrightText: 2026 Bruno Woznicki
SPDX-License-Identifier: GPL-3.0-or-later
"""
import configparser
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
SYSTEM_THEMES = "/usr/share/Kvantum"
LIGHT_BASES = ["KvSimplicity", "KvGnome", "KvFlatLight", "KvArc"]
DARK_BASES = ["KvSimplicityDark", "KvGnomeDark", "KvFlat", "KvArcDark"]
DEFAULT_ACCENT = "#E8833A"   # Amber


def run(cmd):
    if shutil.which(cmd[0]):
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def kread(name, group, key, default=""):
    cp = configparser.ConfigParser(interpolation=None, strict=False, delimiters=("=",))
    cp.optionxform = str
    for p in (os.path.join("/etc/xdg", name), os.path.join(HOME, ".config", name)):
        try:
            cp.read(p, encoding="utf-8")
        except (configparser.Error, UnicodeDecodeError):
            pass
    try:
        return cp.get(group, key)
    except (configparser.Error, KeyError):
        return default


def accent_now():
    for key in ("LastUsedCustomAccentColor", "AccentColor"):
        parts = [p.strip() for p in kread("kdeglobals", "General", key).split(",")]
        if len(parts) >= 3 and all(p.isdigit() for p in parts[:3]):
            return "#%02X%02X%02X" % tuple(int(x) for x in parts[:3])
    return DEFAULT_ACCENT


def rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def hexc(c):
    return "#%02X%02X%02X" % tuple(max(0, min(255, round(x))) for x in c)


def mix(a, b, t):
    a, b = rgb(a), rgb(b)
    return hexc(tuple(a[i] + (b[i] - a[i]) * t for i in range(3)))


def palette(accent, dark):
    """The same Material You colours mOS Settings uses."""
    if dark:
        return {"primary": mix(accent, "#FFFFFF", 0.35), "onPrimary": mix(accent, "#000000", 0.8),
                "container": mix(accent, "#000000", 0.6), "onContainer": mix(accent, "#FFFFFF", 0.82),
                "secondary": mix(accent, "#2B2930", 0.82), "surface": mix(accent, "#141218", 0.94),
                "surfaceContainer": mix(accent, "#1D1B20", 0.9), "surfaceHigh": mix(accent, "#2B2930", 0.9),
                "text": "#E6E0E9", "textVariant": "#CAC4D0", "outline": "#49454F", "disabled": "#7A757F"}
    return {"primary": mix(accent, "#000000", 0.12), "onPrimary": "#FFFFFF",
            "container": mix(accent, "#FFFFFF", 0.78), "onContainer": mix(accent, "#000000", 0.7),
            "secondary": mix(accent, "#FFFFFF", 0.86), "surface": mix(accent, "#FFFBFF", 0.96),
            "surfaceContainer": mix(accent, "#F7F2FA", 0.9), "surfaceHigh": "#FFFFFF",
            "text": "#1D1B20", "textVariant": "#49454F", "outline": mix(accent, "#CAC4D0", 0.85), "disabled": "#9E9AA3"}


def find_base(dark):
    for name in (DARK_BASES if dark else LIGHT_BASES):
        d = os.path.join(SYSTEM_THEMES, name)
        if os.path.exists(os.path.join(d, name + ".kvconfig")) and os.path.exists(os.path.join(d, name + ".svg")):
            return d, name
    return None, None


def set_key(text, section, key, value, add_section=True):
    """Set key=value inside [section] of a kvconfig (add it if missing)."""
    m = re.search(r"^\[" + re.escape(section) + r"\]\s*$", text, re.M)
    if not m:
        return text + f"\n[{section}]\n{key}={value}\n" if add_section else text
    start = m.end()
    nxt = re.search(r"^\[", text[start:], re.M)
    end = start + nxt.start() if nxt else len(text)
    body = text[start:end]
    if re.search(r"^" + re.escape(key) + r"\s*=", body, re.M):
        body = re.sub(r"^" + re.escape(key) + r"\s*=.*$", f"{key}={value}", body, count=1, flags=re.M)
    else:
        body = "\n" + f"{key}={value}" + body
    return text[:start] + body + text[end:]


def make(dest_dir, theme_name, accent, dark):
    base_dir, base = find_base(dark)
    if not base_dir:
        print("mos-kvantum: Kvantum's own themes aren't installed", file=sys.stderr)
        return False
    p = palette(accent, dark)
    cfg = open(os.path.join(base_dir, base + ".kvconfig"), encoding="utf-8", errors="replace").read()
    svg = open(os.path.join(base_dir, base + ".svg"), encoding="utf-8", errors="replace").read()

    # Swap the base theme's own colours for mOS ones everywhere they appear
    old = {}
    cp = configparser.ConfigParser(interpolation=None, strict=False)
    cp.optionxform = str
    try:
        cp.read_string(cfg)
        old = dict(cp["GeneralColors"]) if cp.has_section("GeneralColors") else {}
    except configparser.Error:
        pass
    swap = {"highlight.color": p["primary"], "window.color": p["surface"], "base.color": p["surfaceHigh"],
            "alt.base.color": p["surfaceContainer"], "button.color": p["secondary"]}
    for key, new in swap.items():
        o = (old.get(key) or "").strip()
        if re.fullmatch(r"#[0-9a-fA-F]{6}", o):
            svg = re.sub(re.escape(o), new, svg, flags=re.I)

    colours = {
        "window.color": p["surface"], "base.color": p["surfaceHigh"], "alt.base.color": p["surfaceContainer"],
        "button.color": p["secondary"], "light.color": mix(p["surfaceHigh"], "#FFFFFF", 0.4),
        "mid.light.color": p["surfaceContainer"], "dark.color": p["outline"], "mid.color": p["outline"],
        "highlight.color": p["primary"], "inactive.highlight.color": p["container"],
        "text.color": p["text"], "window.text.color": p["text"], "button.text.color": p["onContainer"],
        "disabled.text.color": p["disabled"], "tooltip.text.color": p["text"],
        "highlight.text.color": p["onPrimary"], "link.color": p["primary"],
        "link.visited.color": mix(p["primary"], p["text"], 0.35), "progress.indicator.text.color": p["onPrimary"],
    }
    for k, v in colours.items():
        cfg = set_key(cfg, "GeneralColors", k, v)
    # Round everything off like Material 3: pill buttons and fields, rounder menus
    for section, exp in (("PanelButtonCommand", 40), ("PanelButtonTool", 40), ("ToolbarButton", 40),
                         ("ComboBox", 40), ("LineEdit", 40), ("DropDownButton", 40), ("IndicatorSpinBox", 40),
                         ("Progressbar", 40), ("ProgressbarContents", 40), ("ScrollbarSlider", 40),
                         ("ItemView", 16), ("Menu", 14), ("ToolTip", 12)):
        cfg = set_key(cfg, section, "frame.expansion", exp, add_section=False)
    for section in ("PanelButtonCommand", "PanelButtonTool", "ToolbarButton", "ComboBox"):
        cfg = set_key(cfg, section, "text.normal.color", p["onContainer"], add_section=False)
        cfg = set_key(cfg, section, "text.focus.color", p["onContainer"], add_section=False)
    cfg = set_key(cfg, "%General", "comment", "mOS: Material You, made from " + base)
    cfg = set_key(cfg, "%General", "author", "Bruno Woznicki (mOS)")
    cfg = set_key(cfg, "%General", "animate_states", "true")
    cfg = set_key(cfg, "%General", "menu_shadow_depth", "7")
    cfg = set_key(cfg, "%General", "tooltip_shadow_depth", "6")

    os.makedirs(dest_dir, exist_ok=True)
    with open(os.path.join(dest_dir, theme_name + ".kvconfig"), "w", encoding="utf-8") as f:
        f.write(cfg)
    with open(os.path.join(dest_dir, theme_name + ".svg"), "w", encoding="utf-8") as f:
        f.write(svg)
    return True


def main(argv):
    if "--off" in argv:
        run(["kwriteconfig6", "--notify", "--file", "kdeglobals", "--group", "KDE", "--key", "widgetStyle", "Breeze"])
        return
    if "--system" in argv:
        ok = make(os.path.join(SYSTEM_THEMES, "mOS"), "mOS", DEFAULT_ACCENT, False)
        ok = make(os.path.join(SYSTEM_THEMES, "mOS-Dark"), "mOS-Dark", DEFAULT_ACCENT, True) and ok
        if ok:
            os.makedirs("/etc/xdg/Kvantum", exist_ok=True)
            with open("/etc/xdg/Kvantum/kvantum.kvconfig", "w") as f:
                f.write("[General]\ntheme=mOS\n")
        sys.exit(0 if ok else 1)
    dark = "dark" in kread("kdeglobals", "General", "ColorScheme", "mOSLight").lower()
    if make(os.path.join(HOME, ".config", "Kvantum", "mOS-You"), "mOS-You", accent_now(), dark):
        os.makedirs(os.path.join(HOME, ".config", "Kvantum"), exist_ok=True)
        with open(os.path.join(HOME, ".config", "Kvantum", "kvantum.kvconfig"), "w") as f:
            f.write("[General]\ntheme=mOS-You\n")
        run(["kwriteconfig6", "--notify", "--file", "kdeglobals", "--group", "KDE", "--key", "widgetStyle", "kvantum"])


if __name__ == "__main__":
    main(sys.argv[1:])
