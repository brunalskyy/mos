#!/usr/bin/env python3
"""mos-migrate: after an mOS update, bring your desktop up to date (once per version).

0.6.1: the taskbar gets the Control Centre and the clock with notifications,
the mOS Store replaces Discover, At a glance joins the desktop, and apps get
round Material buttons.
0.6.2: the KDE apps mOS replaces disappear from the Start menu and search.
0.7: mOS Liquid Glass takes over from KDE's blur (if you had glass switched on).
0.7.1: the taskbar is rebuilt always see-through, so the glass shows over maximised windows.
0.7.2: the mOS right-click menu on the desktop, and the floating glass taskbar.

SPDX-FileCopyrightText: 2026 Bruno Woznicki
SPDX-License-Identifier: GPL-3.0-or-later
"""
import json
import os
import sys
import time

sys.path.insert(0, "/usr/lib/mos-settings")
import mos_settings as m  # noqa: E402

MARK = os.path.join(m.MOS_CONFIG, "migrated")
APPLETS = os.path.join(m.CONFIG, "plasma-org.kde.plasma.desktop-appletsrc")
STEP = "0.7.2"

# 0.7: the clock and battery widgets got squashed to their smallest size; put them back
WIDGET_SIZE_JS = """
var ds = desktops();
var sizes = {"org.mos.clock": 12, "org.mos.battery": 8};
for (var i = 0; i < ds.length; i++) {
    var ws = ds[i].widgets();
    for (var j = 0; j < ws.length; j++) {
        var want = sizes[ws[j].type];
        if (!want) continue;
        var g = ws[j].geometry;
        if (g.width < gridUnit * (want - 1)) {
            ws[j].geometry = new QRectF(g.x, g.y, gridUnit * want, gridUnit * want);
        }
    }
}
print("ok");
"""

GLANCE_JS = """
var ds = desktops();
for (var i = 0; i < ds.length; i++) {
    if (ds[i].widgets("org.mos.glance").length === 0) {
        ds[i].addWidget("org.mos.glance", gridUnit * 2, gridUnit * 7, gridUnit * 20, gridUnit * 5);
    }
}
print("ok");
"""


def main():
    try:
        done = open(MARK).read().strip()
    except OSError:
        done = ""
    if done == STEP:
        return
    time.sleep(8)   # let Plasma finish starting (and save a brand-new desktop) first
    try:
        layout = open(APPLETS).read()
    except OSError:
        layout = ""
    # each update rebuilds the taskbar once (your pinned apps and choices are kept)
    if True:
        # wait for Plasma to be ready
        for _ in range(30):
            ok, _ = m.plasma_script("print('ok')")
            if ok:
                break
            time.sleep(2)
        opts = dict(m.Backend.TASKBAR_DEFAULTS)
        opts.update(m.load_json(os.path.join(m.MOS_CONFIG, "taskbar.json"), {}))
        js = open(os.path.join(m.HERE, "taskbar.js")).read().replace("__OPTIONS__", json.dumps(opts))
        m.plasma_script(js)
        m.plasma_script(GLANCE_JS)
        m.plasma_script(WIDGET_SIZE_JS)
    if m.app_style_on():
        m.sh(["mos-kvantum"], timeout=60)
    # 0.7: Liquid Glass replaces KDE's blur, keeping your glass on/off choice
    if m.liquid_glass_installed():
        glass = m.kread("kwinrc", "Plugins", "blurEnabled", "true").lower() == "true" or \
            m.kread("kwinrc", "Plugins", "mosglassEnabled", "false").lower() == "true"
        m.kwrite("kwinrc", "Plugins", "mosglassEnabled", glass)
        m.kwrite("kwinrc", "Plugins", "blurEnabled", False)
        m.kwrite("kwinrc", "Plugins", "slidingpopupsEnabled", not glass)
        m.kwin_reconfigure()
    # 0.7.2: right-click on the desktop gives the mOS menu (needs the desktop restarted once)
    import glob
    if glob.glob("/usr/lib/*/qt6/plugins/plasma/containmentactions/org.mos.desktopmenu.so"):
        current = m.kread("plasma-org.kde.plasma.desktop-appletsrc", ["ActionPlugins", "0"], "RightButton;NoModifier", "")
        if current != "org.mos.desktopmenu":
            m.kwrite("plasma-org.kde.plasma.desktop-appletsrc", ["ActionPlugins", "0"], "RightButton;NoModifier",
                     "org.mos.desktopmenu")
            m.sh(["systemctl", "--user", "restart", "plasma-plasmashell.service"], timeout=60)
    # 0.6.2: pick up the hidden KDE apps (no second Settings in search)
    m.sh(["kbuildsycoca6"], timeout=180)
    os.makedirs(m.MOS_CONFIG, exist_ok=True)
    with open(MARK, "w") as f:
        f.write(STEP)


if __name__ == "__main__":
    main()
