# mOS Files: works like Windows 11 File Explorer
[General]
# Opens on Home, not the tabs from last time
RememberOpenedTabs=false
# Clickable path (breadcrumbs) in the address bar
ShowFullPath=false
EditableUrl=false
# Simple status bar at the bottom ("8 items"), like Explorer
ShowStatusBar=true
ShowZoomSlider=false
ShowSpaceInfo=false
# Rename right in the file list (F2), like Explorer
RenameInline=true
BrowseThroughArchives=false
ShowSelectionToggle=false
OpenNewTabAfterLastTab=true
ConfirmClosingMultipleTabs=false

[MainWindow]
MenuBar=Disabled
ToolBarsMovable=Disabled

[PreviewSettings]
Plugins=appimagethumbnail,audiothumbnail,blenderthumbnail,comicbookthumbnail,cursorthumbnail,djvuthumbnail,ebookthumbnail,exrthumbnail,directorythumbnail,fontthumbnail,imagethumbnail,jpegthumbnail,kraorathumbnail,windowsexethumbnail,windowsimagethumbnail,opendocumentthumbnail,svgthumbnail,ffmpegthumbs
