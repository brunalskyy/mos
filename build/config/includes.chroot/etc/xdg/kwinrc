[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__mOS
ButtonsOnLeft=
ButtonsOnRight=IAX

[Plugins]
# mOS Liquid Glass (bending glass) replaces KDE's blur; mos-glass-guard switches
# KDE's blur back on for the session if Liquid Glass ever fails to load
blurEnabled=false
mosglassEnabled=true
contrastEnabled=true
# Pop-ups drop out of the taskbar like a droplet (Liquid Glass) instead of sliding
slidingpopupsEnabled=false
# macOS-style: zoom windows in and out, genie (magic lamp) when minimising
scaleEnabled=true
fadeEnabled=false
magiclampEnabled=true
squashEnabled=false
# No app icon stuck to the cursor while an app opens
startupfeedbackEnabled=false

[Effect-blur]
BlurStrength=12
NoiseStrength=2

[Effect-mosglass]
BlurStrength=9
NoiseStrength=2

[Effect-magiclamp]
AnimationDuration=300
